<Window x:Class="AppsJuragan.SyncClient.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppsJuragan Sync — Settings"
        Width="480" Height="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="⚙ Settings" FontSize="20" FontWeight="Black"
                   Foreground="#7C6AF0" Margin="0,0,0,24"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Server URL -->
                <TextBlock Text="Server URL" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DarkTextBox}" Margin="0,0,0,16"/>

                <!-- Local folder -->
                <TextBlock Text="Local Sync Folder" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding LocalFolder, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}" Grid.Column="0" Margin="0,0,8,0"/>
                    <Button Content="Browse" Style="{StaticResource SecondaryButton}"
                            Grid.Column="1" Command="{Binding BrowseFolderCommand}"/>
                </Grid>

                <!-- Sync Mode -->
                <TextBlock Text="Sync Mode" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding SyncModes}"
                          SelectedItem="{Binding SyncMode}"
                          Style="{StaticResource DarkComboBox}" Margin="0,0,0,16"/>

                <!-- Sync interval -->
                <TextBlock Text="Sync Interval (seconds)" Style="{StaticResource FieldLabel}"/>
                <Slider Value="{Binding SyncInterval}" Minimum="15" Maximum="3600"
                        TickFrequency="15" IsSnapToTickEnabled="True"
                        Foreground="#7C6AF0" Margin="0,4,0,4"/>
                <TextBlock Text="{Binding SyncInterval, StringFormat='{}{0}s'}"
                           Foreground="#8B8FA8" FontSize="12" Margin="0,0,0,16"/>

                <!-- Toggles -->
                <CheckBox Content="Run on Windows startup" IsChecked="{Binding RunOnStartup}"
                          Foreground="#C8CCE0" Margin="0,0,0,10"/>
                <CheckBox Content="Show notifications" IsChecked="{Binding ShowNotifications}"
                          Foreground="#C8CCE0" Margin="0,0,0,20"/>

                <!-- Concurrent transfers -->
                <TextBlock Text="Max concurrent transfers" Style="{StaticResource FieldLabel}"/>
                <ComboBox SelectedItem="{Binding MaxTransfers}"
                          Style="{StaticResource DarkComboBox}" Margin="0,0,0,16">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="5"/>
                </ComboBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Save / Cancel -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                    Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
