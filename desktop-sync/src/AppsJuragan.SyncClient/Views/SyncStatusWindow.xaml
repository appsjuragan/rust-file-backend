<Window x:Class="AppsJuragan.SyncClient.Views.SyncStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:view="clr-namespace:AppsJuragan.SyncClient.Views"
        x:Name="StatusWindow"
        Title="AppsJuragan Sync — Status"
        Width="560" Height="560"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117"
        Icon="/Resources/Icons/app.ico">
    <Window.Resources>
        <view:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <view:BoolToIconConverter x:Key="BoolToIconConverter"/>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header & Profile -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="🗂 AppsJuragan Sync" FontSize="22" FontWeight="Black"
                           Foreground="#7C6AF0"/>
                <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="#8B8FA8"
                           Margin="0,4,0,0"/>
            </StackPanel>
            
            <Border Grid.Column="1" Background="#1E2130" Padding="12,8" CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="34" Height="34" Margin="0,0,12,0">
                        <Border CornerRadius="17" Background="#7C6AF0">
                            <TextBlock Text="👤" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                        </Border>
                        <Border CornerRadius="17" ClipToBounds="True">
                            <Image Source="{Binding FullAvatarUrl}" Stretch="UniformToFill"/>
                        </Border>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Profile.Name, FallbackValue='Name'}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="{Binding StorageFormatted}" Foreground="#8B8FA8" FontSize="11" Margin="0,1,0,0"/>
                        <Button Command="{Binding SignOutCommand}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,0" HorizontalAlignment="Left" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock Text="Logout" Foreground="#E05252" FontSize="11" TextDecorations="Underline"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Stats bar -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="{Binding TotalSynced}" FontSize="26" FontWeight="Black"
                               Foreground="#7C6AF0" HorizontalAlignment="Center"/>
                    <TextBlock Text="Files Synced" Foreground="#8B8FA8" FontSize="11"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="{Binding TotalShared}" FontSize="26" FontWeight="Black"
                               Foreground="#4ECCA3" HorizontalAlignment="Center"/>
                    <TextBlock Text="Shared" Foreground="#8B8FA8" FontSize="11"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="{Binding TotalFavorites}" FontSize="26" FontWeight="Black"
                               Foreground="#F5C542" HorizontalAlignment="Center"/>
                    <TextBlock Text="Favorites" Foreground="#8B8FA8" FontSize="11"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Content Tabs -->
        <TabControl Grid.Row="2" Margin="0,0,0,4">
            <TabItem Header="Activity Log">
                <ScrollViewer Margin="12">
                    <ItemsControl ItemsSource="{Binding ActivityLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#8B8FA8" FontSize="12"
                                           Margin="0,1" FontFamily="Cascadia Mono, Consolas, monospace"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Shared Items">
                <ScrollViewer Margin="12">
                    <ItemsControl ItemsSource="{Binding SharedItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ClickableItem}" Padding="8,6" Margin="0,1" Cursor="Hand"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy Shared Link" 
                                                      Command="{Binding PlacementTarget.Tag.CopyShareLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="🔗" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Copy Local Path" 
                                                      Command="{Binding PlacementTarget.Tag.CopyLocalPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="📂" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Show in Explorer" 
                                                      Command="{Binding PlacementTarget.Tag.OpenItemInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="📁" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding IsFolder, Converter={StaticResource BoolToIconConverter}}" 
                                                   FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RelativePath}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ShareUrl}" Foreground="#8B8FA8" FontSize="10" FontStyle="Italic" Visibility="{Binding ShareUrl, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="🔗 Shared" Foreground="#4ECCA3" FontSize="10" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Favorites">
                <ScrollViewer Margin="12">
                    <ItemsControl ItemsSource="{Binding FavoriteItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ClickableItem}" Padding="8,6" Margin="0,1" Cursor="Hand"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy Local Path" 
                                                      Command="{Binding PlacementTarget.Tag.CopyLocalPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="📂" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Show in Explorer" 
                                                      Command="{Binding PlacementTarget.Tag.OpenItemInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="📁" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding IsFolder, Converter={StaticResource BoolToIconConverter}}" 
                                                   FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding RelativePath}" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="⭐ Fav" Foreground="#F5C542" FontSize="10" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0"
                    HorizontalAlignment="Right">
            <Button Content="Sync Now" Style="{StaticResource PrimaryButton}"
                    Command="{Binding SyncNowCommand}" Margin="0,0,8,0"/>
            <Button Content="Open Sync Folder" Style="{StaticResource SecondaryButton}"
                    Command="{Binding OpenFolderCommand}"/>
        </StackPanel>
    </Grid>
</Window>
