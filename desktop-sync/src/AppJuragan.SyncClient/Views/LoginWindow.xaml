<Window x:Class="AppJuragan.SyncClient.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AppJuragan.SyncClient.ViewModels"
        Title="AppJuragan — Sign In"
        Width="420" Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <!-- Gradient background panel -->
        <Border CornerRadius="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F1117" Offset="0"/>
                    <GradientStop Color="#1A1D27" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <StackPanel Margin="40" VerticalAlignment="Center">
            <!-- Logo / Title -->
            <TextBlock Text="🗂 AppJuragan"
                       FontSize="28" FontWeight="Black"
                       Foreground="#7C6AF0"
                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock Text="Desktop Sync"
                       FontSize="14" Foreground="#8B8FA8"
                       HorizontalAlignment="Center" Margin="0,0,0,32"/>

            <!-- OTP code display -->
            <Border Background="#1E2130" CornerRadius="12" Padding="20"
                    Visibility="{Binding OtpVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Open the web app and go to:" Foreground="#8B8FA8" 
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding VerificationUri}" Foreground="#7C6AF0"
                               TextWrapping="Wrap" TextAlignment="Center"
                               FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <TextBlock Text="Enter this code:" Foreground="#8B8FA8"
                               TextAlignment="Center" Margin="0,0,0,8"/>

                    <!-- Prominent 6-digit OTP -->
                    <Border Background="#12141C" CornerRadius="8" Padding="12,16">
                        <TextBlock Text="{Binding UserCode}"
                                   FontSize="42" FontWeight="Black"
                                   FontFamily="Courier New"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Countdown -->
                    <TextBlock Text="{Binding CountdownText}"
                               Foreground="{Binding CountdownColor}"
                               FontSize="12" TextAlignment="Center" Margin="0,12,0,0"/>

                    <!-- Polling indicator -->
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,12,0,0"
                                 Foreground="#7C6AF0" Background="#1E2130"
                                 Visibility="{Binding IsPolling, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- Start sign-in button -->
            <Button Content="Sign in with OTP"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding StartSignInCommand}"
                    Visibility="{Binding StartVisible, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,0,12"/>

            <!-- Manual server URL -->
            <Expander Header="Advanced" Foreground="#8B8FA8" Margin="0,8,0,0">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Server URL" Foreground="#8B8FA8" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}"/>
                </StackPanel>
            </Expander>

            <!-- Error message -->
            <Border Background="#2D1B1B" CornerRadius="8" Padding="12" Margin="0,12,0,0"
                    Visibility="{Binding ErrorVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#FF6B6B" TextWrapping="Wrap" TextAlignment="Center"/>
            </Border>

            <!-- Success -->
            <Border Background="#1B2D1B" CornerRadius="8" Padding="12" Margin="0,12,0,0"
                    Visibility="{Binding SuccessVisible, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="✓ Authenticated! Starting sync..."
                           Foreground="#6BFF8A" TextAlignment="Center" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>
